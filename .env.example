# Supabase
# When these are left empty, the app runs against local mock data and mock auth
# (dev-only) so the prototype works before Supabase is provisioned.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# n8n
# Webhook that receives the meeting audio + payload described in
# src/services/n8n.ts. When empty, the app runs in MOCK MODE: it waits
# ~1s and returns a synthetic N8nAnalysisResponse so the full flow can be
# demoed without a real n8n workflow.
VITE_N8N_ANALYZE_MEETING_WEBHOOK=

# Optional: if you deploy the Supabase Edge Function in
# supabase/functions/analyze-meeting, calls are routed through it instead
# of hitting the n8n webhook directly from the browser (recommended for
# production so the webhook URL/secret never reaches the client).
VITE_USE_EDGE_FUNCTION_PROXY=false
